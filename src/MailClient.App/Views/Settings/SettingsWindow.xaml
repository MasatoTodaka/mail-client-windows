<Window
    x:Class="MailClient.App.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:MailClient.Core.Models"
    mc:Ignorable="d"
    Title="設定">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" Foreground="{ThemeResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontFamily}">
    <Grid Background="{ThemeResource AppBackgroundBrush}">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="8" MinWidth="420">

            <TextBlock Text="外観" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <RadioButtons Header="テーマ" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" AutomationProperties.Name="テーマ">
                <x:String>システムの設定に合わせる</x:String>
                <x:String>ライト</x:String>
                <x:String>ダーク</x:String>
            </RadioButtons>

            <TextBlock Text="通知" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <ToggleSwitch Header="新着メールをデスクトップ通知で知らせる" IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" />
            <ToggleSwitch Header="ワンタイムパスワードを自動でクリップボードにコピーする" IsOn="{x:Bind ViewModel.OtpAutoCopyEnabled, Mode=TwoWay}" />

            <TextBlock Text="表示" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <ToggleSwitch Header="差出人のアイコンに企業ロゴを表示する" IsOn="{x:Bind ViewModel.ShowSenderLogosEnabled, Mode=TwoWay}" />
            <TextBlock
                Text="送信者のメールアドレスのドメインを外部サービス（Google）へ問い合わせてロゴを取得します。取得できない場合は今まで通り色付きイニシャルを表示します。"
                Foreground="{ThemeResource TextSecondaryBrush}"
                TextWrapping="Wrap"
                FontSize="12" />

            <TextBlock Text="アカウント" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <Button Click="OnAddAccountClick" HorizontalAlignment="Left" AutomationProperties.Name="アカウントを追加">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE109;" FontSize="14" />
                    <TextBlock Text="アカウントを追加" />
                </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:Account">
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind EmailAddress}" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Click="OnDeleteAccountClick"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="削除"
                                AutomationProperties.Name="削除">
                                <FontIcon Glyph="&#xE74D;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="仕分けルール" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <TextBlock Text="送信者や件名の条件でメールを自動的にフォルダへ振り分けます。" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <Button Content="仕分けルールを管理..." Click="OnManageRulesClick" HorizontalAlignment="Left" />

        </StackPanel>
    </ScrollViewer>
    </Grid>
    </ContentControl>
</Window>
