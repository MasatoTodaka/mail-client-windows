<UserControl
    x:Class="MailClient.App.Views.Shell.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:MailClient.ViewModels.Shell"
    xmlns:model="using:MailClient.Core.Models"
    xmlns:converters="using:MailClient.App.Views.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <converters:SpecialUseToGlyphConverter x:Key="SpecialUseToGlyphConverter" />

        <!-- Folder rows: rounded, a little taller than the default; the soft selection fill comes from App.xaml. -->
        <Style x:Key="FolderItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Spacing="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="8,16,8,0"
            Visibility="{x:Bind EmptyStateVisibility(ViewModel.Accounts.Count), Mode=OneWay}">
            <TextBlock Text="アカウントが登録されていません" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="「設定」からメールアカウントを追加してください。" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Content="設定を開く" Click="OnSettingsClick" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="0"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind AccountListVisibility(ViewModel.Accounts.Count), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="shell:AccountNode">
                        <StackPanel Margin="0,0,0,20">
                            <Grid ColumnSpacing="8" Margin="12,0,8,6" AutomationProperties.Name="{x:Bind DisplayName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind DisplayName}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    VerticalAlignment="Center" />
                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource BadgeBrush}"
                                    CornerRadius="8"
                                    MinWidth="16"
                                    Padding="5,0"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind UnreadTotal, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}}">
                                    <TextBlock
                                        Text="{x:Bind UnreadTotal, Mode=OneWay}"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource OnBadgeBrush}"
                                        HorizontalAlignment="Center" />
                                </Border>
                                <ProgressRing Grid.Column="2" HorizontalAlignment="Left" IsActive="{x:Bind IsConnecting, Mode=OneWay}" Width="14" Height="14" />
                            </Grid>

                            <TextBlock
                                Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap"
                                Margin="12,4,8,0"
                                Visibility="{x:Bind ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            <Button
                                Margin="12,4,0,0"
                                Click="OnRetryClick"
                                Tag="{x:Bind}"
                                AutomationProperties.Name="再試行"
                                Visibility="{x:Bind ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="再試行" />
                                </StackPanel>
                            </Button>

                            <ListView
                                ItemsSource="{x:Bind Folders}"
                                ItemContainerStyle="{StaticResource FolderItemStyle}"
                                SelectionMode="Single"
                                SelectionChanged="OnFolderSelectionChanged"
                                CanReorderItems="True"
                                AllowDrop="True"
                                CanDragItems="True"
                                DragItemsCompleted="OnFolderDragItemsCompleted">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="model:MailFolder">
                                        <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind DisplayName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                Grid.Column="0"
                                                Glyph="{x:Bind SpecialUse, Converter={StaticResource SpecialUseToGlyphConverter}}"
                                                FontSize="16"
                                                VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind UnreadCount}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind UnreadCount, Converter={StaticResource IntToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="4,12,0,4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
            <Button Style="{StaticResource GhostIconButtonStyle}" Click="OnSettingsClick" ToolTipService.ToolTip="設定" AutomationProperties.Name="設定">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
            <Button Style="{StaticResource GhostIconButtonStyle}" Click="OnThemeToggleClick" ToolTipService.ToolTip="ライト / ダークを切り替え" AutomationProperties.Name="ライト / ダークを切り替え">
                <FontIcon Glyph="&#xE706;" FontSize="16" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
