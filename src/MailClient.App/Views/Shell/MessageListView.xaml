<UserControl
    x:Class="MailClient.App.Views.Shell.MessageListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:MailClient.Core.Models"
    xmlns:abstractions="using:MailClient.Core.Abstractions"
    xmlns:converters="using:MailClient.App.Views.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
        <converters:DateTimeOffsetToShortStringConverter x:Key="DateTimeOffsetToShortStringConverter" />
        <converters:SenderInitialConverter x:Key="SenderInitialConverter" />
        <converters:SenderAvatarColorConverter x:Key="SenderAvatarColorConverter" />
        <converters:SenderLogoImageConverter x:Key="SenderLogoImageConverter" />
        <converters:SenderLogoBackgroundConverter x:Key="SenderLogoBackgroundConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,16,16,8" Spacing="8">
            <AutoSuggestBox
                PlaceholderText="すべてのフォルダを検索"
                QueryIcon="Find"
                Text="{x:Bind SearchViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Text="{x:Bind ViewModel.FolderDisplayName, Mode=OneWay}"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Visibility="{x:Bind FolderHeaderVisibility(SearchViewModel.IsSearchActive), Mode=OneWay}" />
            <TextBlock
                Text="検索結果"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Visibility="{x:Bind SearchViewModel.IsSearchActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
            <TextBlock
                Text="{x:Bind SearchViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind SearchViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Left" Width="16" Height="16" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Messages}"
            SelectionMode="Single"
            SelectionChanged="OnMessageSelectionChanged"
            Visibility="{x:Bind FolderHeaderVisibility(SearchViewModel.IsSearchActive), Mode=OneWay}">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#0A84FF" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#0A84FF" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#0972DB" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="White" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="White" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="White" />
            </ListView.Resources>
            <ListView.Footer>
                <Button
                    Content="もっと読み込む"
                    Margin="16,8"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.LoadMoreCommand}"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </ListView.Footer>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:MailMessage">
                    <Grid Padding="16,10" ColumnSpacing="10" AutomationProperties.Name="{x:Bind Subject}" ContextRequested="OnMessageContextRequested">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Grid.Column="0"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Top"
                            Margin="0,5,0,0"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind IsRead, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                        <Grid Grid.Column="1" Width="40" Height="40" VerticalAlignment="Top">
                            <Border
                                CornerRadius="20"
                                Background="{x:Bind FromDisplay, Converter={StaticResource SenderAvatarColorConverter}}">
                                <TextBlock
                                    Text="{x:Bind FromDisplay, Converter={StaticResource SenderInitialConverter}}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <!-- Overlays the colored-initial fallback once (if) a logo for this
                                 sender's domain is already cached — re-evaluated on every
                                 rebind (unlike a Loaded handler), so a recycled container never
                                 keeps showing a previous row's logo. A Border clipping its
                                 Background to CornerRadius anti-aliases noticeably more smoothly
                                 than an Ellipse filled with the same ImageBrush (same technique as
                                 the account unread-count badge, which never showed this problem).
                                 The larger 40px size (was 34px) also makes any residual edge
                                 softness proportionally less noticeable.
                                 An opaque white backing sits behind the logo image (only when a
                                 logo actually exists) so a favicon with a transparent background
                                 doesn't let the colored initial underneath show through and look
                                 like it's colliding with the logo artwork. -->
                            <Border CornerRadius="20" Background="{x:Bind FromAddress, Converter={StaticResource SenderLogoBackgroundConverter}}" />
                            <Border CornerRadius="20">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill" ImageSource="{x:Bind FromAddress, Converter={StaticResource SenderLogoImageConverter}}" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind FromDisplay}"
                                    FontWeight="{x:Bind IsRead, Converter={StaticResource BoolToFontWeightConverter}, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="&#xE129;"
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Visibility="{x:Bind IsFlagged, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    <FontIcon
                                        Glyph="&#xE723;"
                                        FontSize="12"
                                        Opacity="0.6"
                                        Visibility="{x:Bind HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        Text="{x:Bind Date, Converter={StaticResource DateTimeOffsetToShortStringConverter}}"
                                        Opacity="0.6"
                                        FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Text="{x:Bind Subject}"
                                FontWeight="{x:Bind IsRead, Converter={StaticResource BoolToFontWeightConverter}, Mode=OneWay}"
                                Opacity="0.8"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind SearchViewModel.Results}"
            SelectionMode="Single"
            SelectionChanged="OnSearchResultSelectionChanged"
            Visibility="{x:Bind SearchViewModel.IsSearchActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#0A84FF" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#0A84FF" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#0972DB" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="White" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="White" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="White" />
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="abstractions:SearchResult">
                    <Grid Padding="16,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Message.Subject}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Bind Message.FromDisplay}" />
                            <TextBlock
                                Text="{x:Bind Message.Subject}"
                                Opacity="0.8"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Snippet}"
                                Opacity="0.6"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Message.Date, Converter={StaticResource DateTimeOffsetToShortStringConverter}}"
                            Opacity="0.6"
                            VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
