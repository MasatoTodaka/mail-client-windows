<UserControl
    x:Class="MailClient.App.Views.Shell.MessageListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:MailClient.Core.Models"
    xmlns:abstractions="using:MailClient.Core.Abstractions"
    xmlns:converters="using:MailClient.App.Views.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
        <converters:DateTimeOffsetToShortStringConverter x:Key="DateTimeOffsetToShortStringConverter" />
        <converters:SenderInitialConverter x:Key="SenderInitialConverter" />
        <converters:SenderAvatarColorConverter x:Key="SenderAvatarColorConverter" />
        <converters:SenderLogoImageConverter x:Key="SenderLogoImageConverter" />
        <converters:SenderLogoBackgroundConverter x:Key="SenderLogoBackgroundConverter" />

        <!-- One rounded card per message; the soft selection fill comes from App.xaml. -->
        <Style x:Key="MessageCardStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Margin" Value="0,0,12,6" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,8,20,14" Spacing="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{x:Bind ViewModel.FolderDisplayName, Mode=OneWay}"
                    FontSize="26"
                    FontWeight="Bold"
                    Visibility="{x:Bind FolderHeaderVisibility(SearchViewModel.IsSearchActive), Mode=OneWay}" />
                <TextBlock
                    Text="検索結果"
                    FontSize="26"
                    FontWeight="Bold"
                    Visibility="{x:Bind SearchViewModel.IsSearchActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" VerticalAlignment="Center" />
            </Grid>
            <AutoSuggestBox
                PlaceholderText="すべてのフォルダを検索"
                QueryIcon="Find"
                CornerRadius="12"
                Height="40"
                Text="{x:Bind SearchViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
            <TextBlock
                Text="{x:Bind SearchViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind SearchViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Messages}"
            ItemContainerStyle="{StaticResource MessageCardStyle}"
            SelectionMode="Single"
            SelectionChanged="OnMessageSelectionChanged"
            Visibility="{x:Bind FolderHeaderVisibility(SearchViewModel.IsSearchActive), Mode=OneWay}">
            <ListView.Footer>
                <Button
                    Content="もっと読み込む"
                    Margin="0,8,12,16"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.LoadMoreCommand}"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </ListView.Footer>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:MailMessage">
                    <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind Subject}" ContextRequested="OnMessageContextRequested">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Squircle avatar: colored initial, with the sender's logo layered on top
                             once one is cached and sharp enough (see SenderLogoRender). The white
                             backing keeps a transparent-background logo from showing the initial. -->
                        <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Top">
                            <Border
                                CornerRadius="{StaticResource AvatarCornerRadius}"
                                Background="{x:Bind FromDisplay, Converter={StaticResource SenderAvatarColorConverter}}">
                                <TextBlock
                                    Text="{x:Bind FromDisplay, Converter={StaticResource SenderInitialConverter}}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="17"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="{StaticResource AvatarCornerRadius}" Background="{x:Bind FromAddress, Converter={StaticResource SenderLogoBackgroundConverter}}" />
                            <Border CornerRadius="{StaticResource AvatarCornerRadius}">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill" ImageSource="{x:Bind FromAddress, Converter={StaticResource SenderLogoImageConverter}}" />
                                </Border.Background>
                            </Border>
                            <!-- Unread marker on the avatar corner. -->
                            <Ellipse
                                Width="12"
                                Height="12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0"
                                Fill="{ThemeResource AccentBrush}"
                                Stroke="{ThemeResource SurfaceBrush}"
                                StrokeThickness="2"
                                Visibility="{x:Bind IsRead, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind FromDisplay}"
                                    FontSize="14.5"
                                    FontWeight="{x:Bind IsRead, Converter={StaticResource BoolToFontWeightConverter}, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="&#xE129;"
                                        FontSize="12"
                                        Foreground="{ThemeResource FlagBrush}"
                                        Visibility="{x:Bind IsFlagged, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    <FontIcon
                                        Glyph="&#xE723;"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        Visibility="{x:Bind HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        Text="{x:Bind Date, Converter={StaticResource DateTimeOffsetToShortStringConverter}}"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Text="{x:Bind Subject}"
                                FontSize="13.5"
                                FontWeight="{x:Bind IsRead, Converter={StaticResource BoolToFontWeightConverter}, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <!-- Only present once a body preview is known (it is filled in when the
                                 message is opened); otherwise the row stays two lines tall. -->
                            <TextBlock
                                Text="{x:Bind Snippet, Mode=OneWay}"
                                FontSize="12.5"
                                LineHeight="18"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind Snippet, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind SearchViewModel.Results}"
            ItemContainerStyle="{StaticResource MessageCardStyle}"
            SelectionMode="Single"
            SelectionChanged="OnSearchResultSelectionChanged"
            Visibility="{x:Bind SearchViewModel.IsSearchActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="abstractions:SearchResult">
                    <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind Message.Subject}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind Message.FromDisplay}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Message.Subject}"
                                FontSize="13.5"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Snippet}"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                FontSize="12.5"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Message.Date, Converter={StaticResource DateTimeOffsetToShortStringConverter}}"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            FontSize="12"
                            VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
