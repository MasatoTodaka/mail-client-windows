<UserControl
    x:Class="MailClient.App.Views.Shell.ReadingPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MailClient.App.Views.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter" />
        <converters:DateTimeOffsetToShortStringConverter x:Key="DateTimeOffsetToShortStringConverter" />
    </UserControl.Resources>

    <!-- The whole reading pane is one large rounded card on the app background. -->
    <Border
        Background="{ThemeResource SurfaceBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CardCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Shown until a message is opened. -->
            <TextBlock
                Grid.RowSpan="3"
                Text="メールを選択してください"
                Foreground="{ThemeResource TextSecondaryBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind NoSelectionVisibility(ViewModel.SelectedMessage), Mode=OneWay}" />

            <StackPanel
                Grid.Row="0"
                Padding="40,24,40,16"
                Spacing="20"
                Visibility="{x:Bind ViewModel.SelectedMessage, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="-8,0,0,0">
                        <Button Style="{StaticResource PillButtonStyle}" Click="OnReplyClick" ToolTipService.ToolTip="返信" AutomationProperties.Name="返信">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE97A;" FontSize="14" />
                                <TextBlock Text="返信" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostIconButtonStyle}" Click="OnReplyAllClick" ToolTipService.ToolTip="全員に返信" AutomationProperties.Name="全員に返信">
                            <FontIcon Glyph="&#xE8CA;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource GhostIconButtonStyle}" Click="OnForwardClick" ToolTipService.ToolTip="転送" AutomationProperties.Name="転送">
                            <FontIcon Glyph="&#xE72A;" FontSize="16" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                        <Button Style="{StaticResource GhostIconButtonStyle}" Command="{x:Bind ViewModel.ToggleFlagCommand}" ToolTipService.ToolTip="フラグ" AutomationProperties.Name="フラグ">
                            <FontIcon Glyph="&#xE129;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource GhostIconButtonStyle}" Command="{x:Bind ViewModel.ArchiveCommand}" ToolTipService.ToolTip="アーカイブ" AutomationProperties.Name="アーカイブ">
                            <FontIcon Glyph="&#xE7B8;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource GhostIconButtonStyle}" Command="{x:Bind ViewModel.DeleteCommand}" ToolTipService.ToolTip="削除" AutomationProperties.Name="削除">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Text="{x:Bind ViewModel.SelectedMessage.Subject, Mode=OneWay}"
                    FontSize="28"
                    FontWeight="Bold"
                    LineHeight="38"
                    TextWrapping="Wrap" />

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="48" Height="48">
                        <Border
                            CornerRadius="15"
                            Background="{x:Bind SenderAvatarColor(ViewModel.SelectedMessage.FromDisplay), Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind SenderInitial(ViewModel.SelectedMessage.FromDisplay), Mode=OneWay}"
                                Foreground="White"
                                FontSize="19"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <!-- Overlays the colored-initial fallback once (if) a logo that is sharp
                             enough is cached for this sender's domain (see UpdateSenderLogoAsync and
                             SenderLogoRender). SenderLogoBacking gets an opaque white Background only
                             when a logo is shown, so a transparent-background logo doesn't let the
                             initial underneath show through. -->
                        <Border x:Name="SenderLogoBacking" CornerRadius="15" />
                        <Border CornerRadius="15">
                            <Border.Background>
                                <ImageBrush x:Name="SenderLogoBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SelectedMessage.FromDisplay, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedMessage.FromAddress, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.SelectedMessage.Date, Mode=OneWay, Converter={StaticResource DateTimeOffsetToShortStringConverter}}"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        FontSize="12.5"
                        VerticalAlignment="Top" />
                </Grid>

                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Left" Width="16" Height="16" />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                Margin="40,0,40,8"
                CornerRadius="12"
                IsOpen="{x:Bind ViewModel.HasBlockedRemoteImages, Mode=OneWay}"
                Severity="Informational"
                Title="リモート画像をブロックしました"
                Message="プライバシー保護のため、外部サーバーの画像を読み込んでいません。">
                <InfoBar.ActionButton>
                    <Button Content="画像を読み込む" Command="{x:Bind ViewModel.LoadRemoteImagesCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid Grid.Row="2">
                <ScrollViewer Visibility="{x:Bind IsPlainTextVisible(ViewModel.IsHtml), Mode=OneWay}">
                    <TextBlock
                        Margin="40,0,40,32"
                        FontSize="16"
                        LineHeight="29"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.PlainTextBody, Mode=OneWay}" />
                </ScrollViewer>

                <!-- HTML mail is authored for a white page, so it is always shown on one, in dark
                     mode too, where letting the dark card show through would make dark-on-dark text
                     unreadable. The WebView2 itself is created in code (so it can be rebuilt if its
                     browser process dies); this host carries the binding a replaceable child couldn't
                     keep. -->
                <Grid
                    x:Name="BodyWebViewHost"
                    Margin="24,0,24,24"
                    Background="White"
                    Visibility="{x:Bind ViewModel.IsHtml, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
