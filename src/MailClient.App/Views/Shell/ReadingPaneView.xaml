<UserControl
    x:Class="MailClient.App.Views.Shell.ReadingPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MailClient.App.Views.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter" />
        <converters:DateTimeOffsetToShortStringConverter x:Key="DateTimeOffsetToShortStringConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Padding="16,12,16,12"
            Visibility="{x:Bind ViewModel.SelectedMessage, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnReplyClick" ToolTipService.ToolTip="返信" AutomationProperties.Name="返信">
                        <FontIcon Glyph="&#xE165;" />
                    </Button>
                    <Button Click="OnReplyAllClick" ToolTipService.ToolTip="全員に返信" AutomationProperties.Name="全員に返信">
                        <FontIcon Glyph="&#xE716;" />
                    </Button>
                    <Button Click="OnForwardClick" ToolTipService.ToolTip="転送" AutomationProperties.Name="転送">
                        <FontIcon Glyph="&#xE72A;" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.ToggleFlagCommand}" ToolTipService.ToolTip="フラグ" AutomationProperties.Name="フラグ">
                        <FontIcon Glyph="&#xE129;" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.DeleteCommand}" ToolTipService.ToolTip="削除" AutomationProperties.Name="削除">
                        <FontIcon Glyph="&#xE74D;" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.ArchiveCommand}" ToolTipService.ToolTip="アーカイブ" AutomationProperties.Name="アーカイブ">
                        <FontIcon Glyph="&#xE7B8;" />
                    </Button>
                </StackPanel>

                <TextBlock
                    Text="{x:Bind ViewModel.SelectedMessage.Subject, Mode=OneWay}"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    TextWrapping="Wrap" />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="36" Height="36">
                        <Border
                            CornerRadius="18"
                            Background="{x:Bind SenderAvatarColor(ViewModel.SelectedMessage.FromDisplay), Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind SenderInitial(ViewModel.SelectedMessage.FromDisplay), Mode=OneWay}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <!-- Overlays the colored-initial fallback once (if) a real logo for this
                             sender's domain is fetched — see UpdateSenderLogoAsync. A Border
                             clipping its Background to CornerRadius anti-aliases noticeably more
                             smoothly than an Ellipse filled with the same ImageBrush. -->
                        <Border CornerRadius="18">
                            <Border.Background>
                                <ImageBrush x:Name="SenderLogoBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SelectedMessage.FromDisplay, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedMessage.FromAddress, Mode=OneWay}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.SelectedMessage.Date, Mode=OneWay, Converter={StaticResource DateTimeOffsetToShortStringConverter}}"
                        Opacity="0.6"
                        VerticalAlignment="Top" />
                </Grid>

                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Left" Width="16" Height="16" />
            </StackPanel>
        </Border>

        <InfoBar
            Grid.Row="1"
            Margin="16,8,16,0"
            IsOpen="{x:Bind ViewModel.HasBlockedRemoteImages, Mode=OneWay}"
            Severity="Informational"
            Title="リモート画像をブロックしました"
            Message="プライバシー保護のため、外部サーバーの画像を読み込んでいません。">
            <InfoBar.ActionButton>
                <Button Content="画像を読み込む" Command="{x:Bind ViewModel.LoadRemoteImagesCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2">
            <ScrollViewer Visibility="{x:Bind IsPlainTextVisible(ViewModel.IsHtml), Mode=OneWay}">
                <TextBlock
                    Margin="16,0,16,16"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.PlainTextBody, Mode=OneWay}" />
            </ScrollViewer>

            <WebView2
                x:Name="BodyWebView"
                Visibility="{x:Bind ViewModel.IsHtml, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
