<ContentDialog
    x:Class="MailClient.App.Views.AccountSetup.AddAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="アカウントを追加"
    PrimaryButtonText="追加"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
        <StackPanel Spacing="8" MinWidth="380">

            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ErrorMessageVisibility(ViewModel.ErrorMessage), Mode=OneWay}" />

            <TextBox Header="表示名" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}" />
            <TextBox Header="メールアドレス" Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay}" />

            <TextBlock Text="受信サーバー (IMAP)" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <TextBox Header="ホスト" Text="{x:Bind ViewModel.ImapHost, Mode=TwoWay}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="ポート" Text="{x:Bind ViewModel.ImapPortText, Mode=TwoWay}" Margin="0,0,4,0" />
                <ComboBox Grid.Column="1" Header="セキュリティ" ItemsSource="{x:Bind ViewModel.SecurityModeOptions}" SelectedItem="{x:Bind ViewModel.ImapSecurity, Mode=TwoWay}" Margin="4,0,0,0" HorizontalAlignment="Stretch" />
            </Grid>
            <TextBox Header="ユーザー名" Text="{x:Bind ViewModel.ImapUsername, Mode=TwoWay}" />

            <TextBlock Text="送信サーバー (SMTP)" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <TextBox Header="ホスト" Text="{x:Bind ViewModel.SmtpHost, Mode=TwoWay}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="ポート" Text="{x:Bind ViewModel.SmtpPortText, Mode=TwoWay}" Margin="0,0,4,0" />
                <ComboBox Grid.Column="1" Header="セキュリティ" ItemsSource="{x:Bind ViewModel.SecurityModeOptions}" SelectedItem="{x:Bind ViewModel.SmtpSecurity, Mode=TwoWay}" Margin="4,0,0,0" HorizontalAlignment="Stretch" />
            </Grid>
            <TextBox Header="ユーザー名" Text="{x:Bind ViewModel.SmtpUsername, Mode=TwoWay}" />

            <PasswordBox Header="パスワード" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
