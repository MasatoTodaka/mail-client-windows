<Window
    x:Class="MailClient.App.Views.Compose.ComposeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="新規メッセージ">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Header="宛先" Text="{x:Bind ViewModel.To, Mode=TwoWay}" Margin="0,0,0,8" />
        <TextBox Grid.Row="1" Header="Cc" Text="{x:Bind ViewModel.Cc, Mode=TwoWay}" Margin="0,0,0,8" />
        <TextBox Grid.Row="2" Header="件名" Text="{x:Bind ViewModel.Subject, Mode=TwoWay}" Margin="0,0,0,8" />

        <TextBlock
            Grid.Row="3"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Margin="0,0,0,8"
            Visibility="{x:Bind ErrorMessageVisibility(ViewModel.ErrorMessage), Mode=OneWay}" />

        <TextBox
            Grid.Row="4"
            Text="{x:Bind ViewModel.Body, Mode=TwoWay}"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            VerticalContentAlignment="Top"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Margin="0,0,0,8" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
            <Button Content="キャンセル" Click="OnCancelClick" />
            <Button Content="送信" Command="{x:Bind ViewModel.SendCommand}" Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
