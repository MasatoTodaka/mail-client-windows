<Window
    x:Class="MailClient.App.Views.Rules.RulesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:MailClient.Core.Models"
    xmlns:rules="using:MailClient.ViewModels.Rules"
    mc:Ignorable="d"
    Title="仕分けルール">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer Padding="16">
        <StackPanel Spacing="8" MinWidth="460">

            <TextBlock Text="アカウント" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ComboBox
                ItemsSource="{x:Bind ViewModel.Accounts}"
                SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                DisplayMemberPath="DisplayName"
                HorizontalAlignment="Stretch" />

            <TextBlock Text="ルール一覧" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="rules:RuleDisplayItem">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="削除" Click="OnDeleteRuleClick" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Text="ルールはまだありません。"
                Opacity="0.7"
                Visibility="{x:Bind EmptyRulesVisibility(ViewModel.Rules.Count), Mode=OneWay}" />

            <TextBlock Text="新しいルールを追加" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind TextVisibility(ViewModel.ErrorMessage), Mode=OneWay}" />
            <TextBox Header="送信者に含む文字列（任意）" Text="{x:Bind ViewModel.SenderContains, Mode=TwoWay}" />
            <TextBox Header="件名に含む文字列（任意）" Text="{x:Bind ViewModel.SubjectContains, Mode=TwoWay}" />
            <ComboBox
                Header="移動先フォルダ"
                ItemsSource="{x:Bind ViewModel.FoldersForSelectedAccount}"
                SelectedItem="{x:Bind ViewModel.SelectedTargetFolder, Mode=TwoWay}"
                DisplayMemberPath="DisplayName"
                HorizontalAlignment="Stretch" />
            <Button Content="ルールを追加" Command="{x:Bind ViewModel.AddRuleCommand}" Margin="0,4,0,0" />

            <TextBlock Text="既存メールへの適用" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <TextBlock Text="ローカルに保存済みのメールに対して、上のルールを今すぐ適用します。" Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="今すぐ実行" Command="{x:Bind ViewModel.RunNowCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Visibility="{x:Bind TextVisibility(ViewModel.StatusMessage), Mode=OneWay}" />

        </StackPanel>
    </ScrollViewer>
</Window>
