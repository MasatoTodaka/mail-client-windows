<Window
    x:Class="MailClient.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:MailClient.App.Views.Shell"
    mc:Ignorable="d"
    Title="Mail Client">

    <!--
        "Paper" layout: a warm app background carrying three areas: the folder sidebar, the
        message list (one card per message) and the reading pane (a single large card). The root
        owns the background, font and text color; everything inside inherits them, and the whole
        palette switches with the root's RequestedTheme (see ThemeService).
    -->
    <ContentControl
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        IsTabStop="False"
        Background="{ThemeResource AppBackgroundBrush}"
        Foreground="{ThemeResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: the caption buttons are drawn over its right edge by the system. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="ms-appx:///Assets/Square44x44Logo.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Mail" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="8,0,8,8" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <shell:SidebarView x:Name="Sidebar" Grid.Column="0" Margin="8,0,8,0" />
            <shell:MessageListView x:Name="MessageList" Grid.Column="1" />
            <shell:ReadingPaneView x:Name="ReadingPane" Grid.Column="2" />
        </Grid>
    </Grid>
    </ContentControl>
</Window>
