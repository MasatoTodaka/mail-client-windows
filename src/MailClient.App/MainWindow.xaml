<Window
    x:Class="MailClient.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:MailClient.App.Views.Shell"
    mc:Ignorable="d"
    Title="Mail Client">

    <!--
        M0: static 3-pane placeholder shell (sidebar / message list / reading pane), matching
        macOS Mail's fixed layout proportions. All three panes now own real view models
        (sidebar M3, message list M4, reading pane M5), composed here by code-behind.
    -->
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <shell:SidebarView x:Name="Sidebar" Margin="16" />
        </Border>

        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <shell:MessageListView x:Name="MessageList" />
        </Border>

        <shell:ReadingPaneView x:Name="ReadingPane" Grid.Column="2" />
    </Grid>
</Window>
