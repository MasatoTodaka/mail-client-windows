<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MailClient.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MailClient.Core\MailClient.Core.csproj" />
    <ProjectReference Include="..\MailClient.ViewModels\MailClient.ViewModels.csproj" />
    <ProjectReference Include="..\MailClient.Data\MailClient.Data.csproj" />
    <ProjectReference Include="..\MailClient.Mail\MailClient.Mail.csproj" />
  </ItemGroup>

  <!--
    Platform (net8.0-windows10.0.19041.0) is intentionally NOT referenced here.
    A net8.0 project cannot reference a net8.0-windows project (NU1201). Windows-only
    services (ICredentialStore, INotificationService) are registered by MailClient.App
    itself, which already targets net8.0-windows and can see both this project and Platform.
  -->

</Project>
